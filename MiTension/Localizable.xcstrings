    "Mide en los horarios indicados por tu profesional sanitario y lleva el informe a la consulta.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide en los horarios indicados por tu profesional sanitario y lleva el informe a la consulta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure at the times recommended by your healthcare professional and bring the report to your appointment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez aux horaires indiqués par votre professionnel de santé et apportez le rapport à la consultation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messen Sie zu den von Ihrer medizinischen Fachkraft empfohlenen Zeiten und bringen Sie den Bericht zum Termin mit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura negli orari indicati dal professionista sanitario e porta il rapporto alla visita."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça nos horários indicados pelo seu profissional de saúde e leve o relatório à consulta."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesura en els horaris indicats pel teu professional sanitari i porta l'informe a la consulta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在医务人员建议的时间测量，并在就诊时携带报告。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医療従事者が指定した時間に測定し、受診時にレポートを持参します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قِس في الأوقات التي يحددها المختص الصحي وخذ التقرير إلى موعدك."
          }
        }
      }
    },
