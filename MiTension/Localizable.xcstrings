"Selecciona un archivo Excel exportado por Mi Tensión. Se añaden los registros nuevos sin borrar tu histórico ni duplicar tomas.": {
  "extractionState": "manual",
  "localizations": {
    "es": {
      "stringUnit": {
        "state": "translated",
        "value": "Selecciona un archivo Excel exportado por Mi Tensión. Se añaden los registros nuevos sin borrar tu histórico ni duplicar tomas."
      }
    },
    "en": {
      "stringUnit": {
        "state": "translated",
        "value": "Choose an Excel file exported by Mi Tensión. New records are added without deleting your history or duplicating readings."
      }
    },
    "fr": {
      "stringUnit": {
        "state": "translated",
        "value": "Choisissez un fichier Excel exporté par Mi Tensión. Les nouvelles mesures sont ajoutées sans effacer votre historique ni créer de doublons."
      }
    },
    "de": {
      "stringUnit": {
        "state": "translated",
        "value": "Wählen Sie eine von Mi Tensión exportierte Excel-Datei. Neue Messungen werden hinzugefügt, ohne Ihren Verlauf zu löschen oder Messungen zu duplizieren."
      }
    },
    "it": {
      "stringUnit": {
        "state": "translated",
        "value": "Seleziona un file Excel esportato da Mi Tensión. Le nuove misurazioni vengono aggiunte senza cancellare la cronologia o duplicare i dati."
      }
    },
    "pt": {
      "stringUnit": {
        "state": "translated",
        "value": "Selecione um arquivo Excel exportado por Mi Tensión. Novos registros são adicionados sem apagar o histórico nem duplicar medições."
      }
    },
    "ca": {
      "stringUnit": {
        "state": "translated",
        "value": "Selecciona un fitxer Excel exportat per Mi Tensión. S’afegeixen els registres nous sense esborrar l’històric ni duplicar preses."
      }
    },
    "zh-Hans": {
      "stringUnit": {
        "state": "translated",
        "value": "请选择Mi Tensión导出的Excel文件。将添加新记录，不会删除历史或重复测量。"
      }
    },
    "ja": {
      "stringUnit": {
        "state": "translated",
        "value": "Mi Tensiónから書き出したExcelファイルを選択してください。履歴を削除したり測定を重複させたりせず、新しい記録を追加します。"
      }
    },
    "ar": {
      "stringUnit": {
        "state": "translated",
        "value": "اختر ملف Excel مُصدّرًا من Mi Tensión. تُضاف السجلات الجديدة دون حذف السجل أو تكرار القياسات."
      }
    }
  }
},
