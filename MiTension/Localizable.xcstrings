    "No guardamos datos en servidores": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No guardamos datos en servidores"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We do not store data on servers"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne stockons pas de données sur des serveurs"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir speichern keine Daten auf Servern"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non salviamo dati sui server"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não guardamos dados em servidores"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No desem dades en servidors"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们不在服务器上存储数据"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーにデータを保存しません"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا نخزن البيانات على خوادم"
          }
        }
      }
    },
    "Tus tomas y notas se guardan únicamente en el almacenamiento local de este iPhone para que puedas consultar el histórico. La app no exige una cuenta ni envía tus mediciones a nuestros servidores.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tomas y notas se guardan únicamente en el almacenamiento local de este iPhone para que puedas consultar el histórico. La app no exige una cuenta ni envía tus mediciones a nuestros servidores."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your readings and notes are saved only on this iPhone so you can review your history. The app does not require an account or send your readings to our servers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos mesures et notes sont enregistrées uniquement sur cet iPhone pour consulter l'historique. L'app ne nécessite aucun compte et n'envoie pas vos mesures à nos serveurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Messungen und Notizen werden nur auf diesem iPhone gespeichert, damit Sie Ihren Verlauf ansehen können. Die App benötigt kein Konto und sendet keine Messungen an unsere Server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le misurazioni e le note vengono salvate solo su questo iPhone per consultare la cronologia. L'app non richiede un account e non invia le misurazioni ai nostri server."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As medições e notas são guardadas apenas neste iPhone para consultar o histórico. A app não exige conta nem envia as suas medições para os nossos servidores."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les preses i notes es desen només en aquest iPhone perquè puguis consultar l'històric. L'app no exigeix cap compte ni envia les mesures als nostres servidors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的测量和备注仅保存在此 iPhone 上，供您查看历史记录。本应用无需账户，也不会将测量发送到我们的服务器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定とメモは履歴を確認できるよう、このiPhoneにのみ保存されます。アカウントは不要で、測定を当社のサーバーに送信しません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ قراءاتك وملاحظاتك على هذا iPhone فقط لتتمكن من مراجعة السجل. لا يتطلب التطبيق حسابًا ولا يرسل قراءاتك إلى خوادمنا."
          }
        }
      }
    },
    "Solo tú decides si exportas o compartes un informe o una copia. Las copias del dispositivo pueden incluir los datos de la app según tus ajustes de iOS.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tú decides si exportas o compartes un informe o una copia. Las copias del dispositivo pueden incluir los datos de la app según tus ajustes de iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide whether to export or share a report or backup. Device backups may include app data depending on your iOS settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous décidez si vous exportez ou partagez un rapport ou une copie. Les sauvegardes de l'appareil peuvent inclure les données de l'app selon vos réglages iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie entscheiden, ob Sie einen Bericht oder ein Backup exportieren oder teilen. Gerätesicherungen können je nach iOS-Einstellungen App-Daten enthalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi tu se esportare o condividere un rapporto o un backup. I backup del dispositivo possono includere i dati dell'app in base alle impostazioni iOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só você decide se exporta ou partilha um relatório ou cópia. As cópias do dispositivo podem incluir dados da app conforme os ajustes de iOS."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només tu decideixes si exportes o comparteixes un informe o una còpia. Les còpies del dispositiu poden incloure dades de l'app segons els ajustos d'iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否导出或分享报告或备份由您决定。根据您的 iOS 设置，设备备份可能包含应用数据。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートやバックアップの書き出し・共有はご自身で選べます。iOSの設定によっては端末のバックアップにアプリのデータが含まれます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت وحدك تقرر تصدير تقرير أو نسخة أو مشاركتهما. قد تتضمن نسخ الجهاز بيانات التطبيق حسب إعدادات iOS."
          }
        }
      }
    },
    "Eliminar la app puede borrar el histórico local. Exporta una copia si quieres conservarlo.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar la app puede borrar el histórico local. Exporta una copia si quieres conservarlo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting the app may erase local history. Export a backup to keep it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer l'app peut effacer l'historique local. Exportez une copie pour le conserver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen der App kann den lokalen Verlauf entfernen. Exportieren Sie ein Backup, um ihn zu behalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare l'app può cancellare la cronologia locale. Esporta un backup per conservarla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar a app pode apagar o histórico local. Exporte uma cópia para o conservar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar l'app pot esborrar l'històric local. Exporta una còpia per conservar-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除应用可能清除本地历史记录。如需保留，请导出备份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを削除するとローカルの履歴が消える場合があります。残すにはバックアップを書き出してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يؤدي حذف التطبيق إلى مسح السجل المحلي. صدّر نسخة للاحتفاظ به."
          }
        }
      }
    },
