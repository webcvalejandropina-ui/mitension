    "Esta toma tendrá un identificador único y se guardará en este iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta toma tendrá un identificador único y se guardará en este iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reading will have a unique identifier and be saved on this iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette mesure aura un identifiant unique et sera enregistrée sur cet iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Messung erhält eine eindeutige Kennung und wird auf diesem iPhone gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa misurazione avrà un identificativo univoco e sarà salvata su questo iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta medição terá um identificador único e será guardada neste iPhone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta presa tindrà un identificador únic i es desarà en aquest iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此测量将具有唯一标识，并保存在此 iPhone 上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この測定には固有の識別子が付けられ、このiPhoneに保存されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستحصل هذه القراءة على معرّف فريد وستُحفظ على هذا iPhone."
          }
        }
      }
    },
