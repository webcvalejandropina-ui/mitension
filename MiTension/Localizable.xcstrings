    "No se pudo leer el histórico. Se conserva el archivo original; no guardes nuevas tomas hasta recuperarlo.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el histórico. Se conserva el archivo original; no guardes nuevas tomas hasta recuperarlo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The history could not be read. The original file is preserved; recover it before saving new readings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’historique. Le fichier original est conservé ; récupérez-le avant d’enregistrer de nouvelles mesures."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf konnte nicht gelesen werden. Die Originaldatei bleibt erhalten; stellen Sie sie vor neuen Messungen wieder her."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere lo storico. Il file originale è conservato; recuperalo prima di salvare nuove misurazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o histórico. O ficheiro original foi preservado; recupere-o antes de guardar novas medições."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut llegir l’històric. Es conserva el fitxer original; recupera’l abans de desar noves preses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取历史记录。原始文件已保留；请先恢复文件，再保存新的测量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を読み込めませんでした。元のファイルは保持されています。復旧してから新しい測定を保存してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة السجل. تم الاحتفاظ بالملف الأصلي؛ استعده قبل حفظ قياسات جديدة."
          }
        }
      }
    },
