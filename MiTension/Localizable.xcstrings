    "Siéntate en silencio, con la espalda apoyada, los pies en el suelo y las piernas sin cruzar.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en silencio, con la espalda apoyada, los pies en el suelo y las piernas sin cruzar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit quietly with your back supported, feet on the floor and legs uncrossed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous au calme, le dos soutenu, les pieds au sol et les jambes décroisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzen Sie ruhig mit gestütztem Rücken, Füßen auf dem Boden und ungekreuzten Beinen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti in silenzio con la schiena appoggiata, i piedi a terra e le gambe non incrociate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente-se em silêncio, com as costas apoiadas, os pés no chão e as pernas descruzadas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu en silenci, amb l'esquena recolzada, els peus a terra i les cames sense creuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静坐好，背部有支撑，双脚平放地面，双腿不要交叉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背もたれに寄りかかり、足を床につけ、脚を組まずに静かに座ります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجلس بهدوء مع إسناد ظهرك ووضع قدميك على الأرض دون تشبيك ساقيك."
          }
        }
      }
    },
    "Coloca el brazo": {
      "extractionState": "manual",
