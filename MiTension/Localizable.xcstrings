    "Pon el manguito sobre la piel, siguiendo las instrucciones del aparato. Apoya el brazo a la altura del corazón.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon el manguito sobre la piel, siguiendo las instrucciones del aparato. Apoya el brazo a la altura del corazón."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the cuff on bare skin following the monitor's instructions. Support your arm at heart level."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le brassard sur la peau en suivant les instructions de l'appareil. Soutenez le bras à hauteur du cœur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie die Manschette nach Geräteanleitung auf die nackte Haut. Stützen Sie den Arm auf Herzhöhe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona il bracciale sulla pelle seguendo le istruzioni del dispositivo. Appoggia il braccio all'altezza del cuore."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque a braçadeira sobre a pele, seguindo as instruções do aparelho. Apoie o braço à altura do coração."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa el maneguet sobre la pell seguint les instruccions de l'aparell. Recolza el braç a l'altura del cor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按照设备说明将袖带套在裸露的皮肤上。将手臂支撑在心脏高度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機器の説明に従ってカフを素肌に巻き、腕を心臓の高さで支えます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع الكُمّ على الجلد مباشرة وفق تعليمات الجهاز. اسند ذراعك على مستوى القلب."
          }
        }
      }
    },
    "Haz dos tomas": {
      "extractionState": "manual",
      "localizations": {
