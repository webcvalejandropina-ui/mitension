          }
        }
      }
    },
    "No hables ni te muevas. Espera al menos 1 minuto entre las dos mediciones y guarda cada una por separado.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hables ni te muevas. Espera al menos 1 minuto entre las dos mediciones y guarda cada una por separado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not talk or move. Wait at least 1 minute between readings and save each one separately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne parlez pas et ne bougez pas. Attendez au moins 1 minute entre les mesures et enregistrez chacune séparément."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen und bewegen Sie sich nicht. Warten Sie mindestens 1 Minute zwischen den Messungen und speichern Sie jede einzeln."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non parlare e non muoverti. Attendi almeno 1 minuto tra le misurazioni e salva ciascuna separatamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não fale nem se mova. Espere pelo menos 1 minuto entre medições e guarde cada uma separadamente."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No parlis ni et moguis. Espera almenys 1 minut entre les mesures i desa cadascuna per separat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要说话或移动。两次测量之间至少等待 1 分钟，并分别保存每次测量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話したり動いたりせず、測定の間は少なくとも1分待ち、各測定を個別に保存します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتحدث ولا تتحرك. انتظر دقيقة واحدة على الأقل بين القراءتين واحفظ كل قراءة على حدة."
          }
        }
      }
    },
