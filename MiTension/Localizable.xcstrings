    "No se pudo guardar la toma en este iPhone. Inténtalo de nuevo.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la toma en este iPhone. Inténtalo de nuevo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save this reading on this iPhone. Try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer cette mesure sur cet iPhone. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Messung konnte nicht auf diesem iPhone gespeichert werden. Versuchen Sie es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la misurazione su questo iPhone. Riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a medição neste iPhone. Tente novamente."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut desar la presa en aquest iPhone. Torna-ho a provar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此 iPhone 上保存测量。请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneに測定を保存できませんでした。再試行してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ القراءة على هذا iPhone. حاول مجددًا."
          }
        }
      }
    },
