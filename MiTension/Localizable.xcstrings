    "Evita ejercicio, tabaco y cafeína durante los 30 minutos previos. Vacía la vejiga.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita ejercicio, tabaco y cafeína durante los 30 minutos previos. Vacía la vejiga."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid exercise, tobacco and caffeine for 30 minutes beforehand. Empty your bladder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez l'exercice, le tabac et la caféine pendant les 30 minutes précédentes. Videz votre vessie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeiden Sie 30 Minuten vorher Sport, Tabak und Koffein. Entleeren Sie Ihre Blase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita esercizio, tabacco e caffeina nei 30 minuti precedenti. Svuota la vescica."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite exercício, tabaco e cafeína nos 30 minutos anteriores. Esvazie a bexiga."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita exercici, tabac i cafeïna durant els 30 minuts previs. Buida la bufeta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量前 30 分钟避免运动、吸烟和咖啡因。排空膀胱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定前30分間は運動、喫煙、カフェインを避け、トイレを済ませます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجنب الرياضة والتبغ والكافيين خلال الثلاثين دقيقة السابقة. أفرغ المثانة."
          }
        }
      }
    },
