    "La copia contiene datos de salud. Guárdala en un lugar privado y compártela solo con personas de confianza.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia contiene datos de salud. Guárdala en un lugar privado y compártela solo con personas de confianza."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup contains health data. Keep it private and share it only with people you trust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie contient des données de santé. Gardez-la privée et partagez-la uniquement avec des personnes de confiance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup enthält Gesundheitsdaten. Bewahren Sie es privat auf und teilen Sie es nur mit vertrauenswürdigen Personen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup contiene dati sanitari. Conservalo in privato e condividilo solo con persone fidate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia contém dados de saúde. Guarde-a num local privado e partilhe-a apenas com pessoas de confiança."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La còpia conté dades de salut. Desa-la en un lloc privat i comparteix-la només amb persones de confiança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含健康数据。请妥善保管，仅与可信任的人分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップには健康データが含まれます。安全に保管し、信頼できる人とのみ共有してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي النسخة على بيانات صحية. احتفظ بها في مكان خاص وشاركها فقط مع من تثق بهم."
          }
        }
      }
    },
