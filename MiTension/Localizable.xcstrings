    "Las mediciones han sido introducidas por el usuario. Este informe no sustituye la valoración clínica.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mediciones han sido introducidas por el usuario. Este informe no sustituye la valoración clínica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readings were entered by the user. This report does not replace a clinical assessment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures ont été saisies par l'utilisateur. Ce rapport ne remplace pas une évaluation clinique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Messungen wurden vom Nutzer eingegeben. Dieser Bericht ersetzt keine klinische Beurteilung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le misurazioni sono state inserite dall'utente. Questo rapporto non sostituisce una valutazione clinica."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As medições foram introduzidas pelo utilizador. Este relatório não substitui a avaliação clínica."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures les ha introduït l'usuari. Aquest informe no substitueix la valoració clínica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量值由用户输入。本报告不能替代临床评估。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定値はユーザーが入力したものです。このレポートは臨床評価に代わるものではありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل المستخدم القراءات. لا يغني هذا التقرير عن التقييم السريري."
          }
        }
      }
