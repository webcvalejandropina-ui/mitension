    "Usa un tensiómetro validado de brazo y un manguito de tu talla. La app registra las lecturas del aparato.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un tensiómetro validado de brazo y un manguito de tu talla. La app registra las lecturas del aparato."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a validated upper-arm monitor with a cuff that fits. This app records the monitor's readings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un tensiomètre de bras validé et un brassard adapté. L'app enregistre les mesures de l'appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie ein validiertes Oberarmgerät mit passender Manschette. Die App speichert die Messwerte des Geräts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un misuratore da braccio validato con un bracciale della misura corretta. L'app registra le letture del dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um tensiómetro de braço validado com uma braçadeira do tamanho adequado. A app regista as leituras do aparelho."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir un tensiòmetre de braç validat amb un maneguet de la teva talla. L'app registra les lectures de l'aparell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用经过验证的上臂式血压计和合适尺寸的袖带。本应用记录设备的测量值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証済みの上腕式血圧計と適切なサイズのカフを使用します。このアプリは血圧計の測定値を記録します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم جهاز قياس معتمدًا للذراع مع كُمّ مناسب لحجمك. يسجل التطبيق قراءات الجهاز."
          }
        }
      }
    },
