    "Introduce una sistólica entre 40 y 300 mmHg.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una sistólica entre 40 y 300 mmHg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a systolic pressure between 40 and 300 mmHg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une pression systolique entre 40 et 300 mmHg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen systolischen Wert zwischen 40 und 300 mmHg ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una sistolica tra 40 e 300 mmHg."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza uma sistólica entre 40 e 300 mmHg."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix una sistòlica entre 40 i 300 mmHg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 40 至 300 mmHg 的收缩压。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収縮期血圧を40〜300 mmHgで入力してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل ضغطًا انقباضيًا بين 40 و300 ملم زئبق."
          }
        }
      }
    },
    "La diastólica debe estar entre 30 y 200 y ser menor que la sistólica.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La diastólica debe estar entre 30 y 200 y ser menor que la sistólica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diastolic pressure must be between 30 and 200 and lower than systolic pressure."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pression diastolique doit être entre 30 et 200 et inférieure à la systolique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der diastolische Wert muss zwischen 30 und 200 und unter dem systolischen Wert liegen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La diastolica deve essere tra 30 e 200 e inferiore alla sistolica."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A diastólica deve estar entre 30 e 200 e ser inferior à sistólica."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La diastòlica ha d'estar entre 30 i 200 i ser inferior a la sistòlica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "舒张压须在 30 至 200 之间，并低于收缩压。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張期血圧は30〜200で、収縮期血圧より低い値にしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون الضغط الانبساطي بين 30 و200 وأقل من الضغط الانقباضي."
          }
        }
      }
    },
    "Introduce un pulso entre 20 y 250 lpm.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un pulso entre 20 y 250 lpm."
