    "Cada toma se guarda por separado. Introduce los valores de cada medición.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toma se guarda por separado. Introduce los valores de cada medición."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each reading is saved separately. Enter the values for each measurement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mesure est enregistrée séparément. Saisissez les valeurs de chaque mesure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Messung wird einzeln gespeichert. Geben Sie die Werte jeder Messung ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni misurazione viene salvata separatamente. Inserisci i valori di ogni misurazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medição é guardada separadamente. Introduza os valores de cada medição."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada presa es desa per separat. Introdueix els valors de cada mesurament."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次测量分别保存。请输入每次测量的数值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各測定は個別に保存されます。それぞれの測定値を入力してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ كل قراءة بشكل منفصل. أدخل قيم كل قياس."
          }
        }
      }
    },
    "Se asigna automáticamente al guardar según la hora local del iPhone: mañana antes de las 14:00 y noche desde las 14:00. Una toma guardada solo se puede eliminar.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se asigna automáticamente al guardar según la hora local del iPhone: mañana antes de las 14:00 y noche desde las 14:00. Una toma guardada solo se puede eliminar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assigned automatically when saved using the iPhone’s local time: morning before 14:00 and evening from 14:00. Saved readings can only be deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribué automatiquement à l’enregistrement selon l’heure locale de l’iPhone : matin avant 14 h, soir à partir de 14 h. Une mesure enregistrée peut uniquement être supprimée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern automatisch nach der Ortszeit des iPhone: morgens vor 14:00, abends ab 14:00. Gespeicherte Messungen können nur gelöscht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegnato automaticamente al salvataggio secondo l’ora locale dell’iPhone: mattina prima delle 14:00, sera dalle 14:00. Le misurazioni salvate si possono solo eliminare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribuído automaticamente ao guardar pela hora local do iPhone: manhã antes das 14:00 e noite a partir das 14:00. As medições guardadas só podem ser eliminadas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’assigna automàticament en desar segons l’hora local de l’iPhone: matí abans de les 14:00 i nit des de les 14:00. Una presa desada només es pot eliminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存时按 iPhone 本地时间自动设置：14:00 前为早间，14:00 起为晚间。已保存的测量只能删除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存時のiPhoneの現地時刻で自動設定します。14:00より前は朝、14:00以降は夜です。保存済みの測定は削除のみ可能です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحدد تلقائيًا عند الحفظ حسب الوقت المحلي لـ iPhone: صباحًا قبل 14:00 ومساءً من 14:00. يمكن حذف القراءات المحفوظة فقط."
          }
        }
      }
    },
