    "Elige horarios y días para la mañana y la noche. Los avisos están desactivados inicialmente.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige horarios y días para la mañana y la noche. Los avisos están desactivados inicialmente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose times and days for morning and evening. Reminders are initially off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les heures et les jours du matin et du soir. Les rappels sont désactivés au départ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Uhrzeiten und Tage für morgens und abends. Erinnerungen sind anfangs ausgeschaltet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli orari e giorni per mattina e sera. I promemoria sono inizialmente disattivati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha horários e dias para manhã e noite. Os lembretes estão inicialmente desativados."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria hores i dies per al matí i la nit. Els avisos estan desactivats inicialment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择早晚提醒的时间和日期。提醒默认关闭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝と夜の時刻と曜日を選択してください。初期状態では通知はオフです。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أوقات وأيام الصباح والمساء. التذكيرات معطلة افتراضيًا."
          }
        }
      }
    },
